<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_deep">

    <com.floppytap.tetherloom.game.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/hud_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textCombo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="x1"
            android:textColor="@color/energy_gold"
            android:textSize="@dimen/hud_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="@drawable/bg_button"
            android:text="@string/hud_pause"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutPauseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC10131F"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pause_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <Button android:id="@+id/btnResume" style="@style/MenuButtonPrimary"
                android:layout_marginTop="20dp" android:text="@string/pause_resume" />
            <Button android:id="@+id/btnRestartFromPause" style="@style/MenuButton"
                android:text="@string/pause_restart" />
            <Button android:id="@+id/btnSettingsFromPause" style="@style/MenuButton"
                android:text="@string/pause_settings" />
            <Button android:id="@+id/btnMenuFromPause" style="@style/MenuButton"
                android:text="@string/pause_menu" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutGameOverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC10131F"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gameover_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textFinalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="0"
                android:textColor="@color/energy_gold"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textBestScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <Button android:id="@+id/btnRetry" style="@style/MenuButtonPrimary"
                android:layout_marginTop="20dp" android:text="@string/gameover_retry" />
            <Button android:id="@+id/btnGameOverMenu" style="@style/MenuButton"
                android:text="@string/gameover_menu" />

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
