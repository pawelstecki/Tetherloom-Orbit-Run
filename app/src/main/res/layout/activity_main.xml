<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_deep"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/menu_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cardHighScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_panel"
            android:padding="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/menu_high_score_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/textHighScoreValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/energy_gold"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPlay"
            style="@style/MenuButtonPrimary"
            android:layout_marginTop="24dp"
            android:text="@string/menu_play" />

        <Button
            android:id="@+id/btnDaily"
            style="@style/MenuButton"
            android:text="@string/menu_daily" />

        <Button
            android:id="@+id/btnPractice"
            style="@style/MenuButton"
            android:text="@string/menu_practice" />

        <Button
            android:id="@+id/btnProgress"
            style="@style/MenuButton"
            android:text="@string/menu_progress" />

        <Button
            android:id="@+id/btnHowToPlay"
            style="@style/MenuButton"
            android:text="@string/menu_how_to_play" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/MenuButton"
            android:text="@string/menu_settings" />

        <Button
            android:id="@+id/btnCredits"
            style="@style/MenuButton"
            android:layout_marginBottom="24dp"
            android:text="@string/menu_credits" />

    </LinearLayout>
</ScrollView>
