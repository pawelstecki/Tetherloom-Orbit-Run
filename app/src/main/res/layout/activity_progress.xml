<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_deep"
    android:orientation="vertical"
    android:padding="@dimen/menu_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/progress_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_panel"
        android:padding="16dp"
        android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/progress_high_score" android:textColor="@color/text_secondary" android:textSize="@dimen/text_body" />
        <TextView android:id="@+id/textProgressHighScore" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="@color/energy_gold" android:textSize="@dimen/text_title" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_panel"
        android:padding="16dp"
        android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/progress_best_combo" android:textColor="@color/text_secondary" android:textSize="@dimen/text_body" />
        <TextView android:id="@+id/textProgressBestCombo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="@color/prism_violet" android:textSize="@dimen/text_title" android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnProgressBack"
        style="@style/MenuButtonPrimary"
        android:layout_marginTop="24dp"
        android:text="@string/progress_back" />

</LinearLayout>
