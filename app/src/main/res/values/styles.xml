<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MenuButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/menu_button_height</item>
        <item name="android:layout_marginTop">@dimen/menu_spacing</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="MenuButtonPrimary" parent="MenuButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/background_deep</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SecondaryButton" parent="MenuButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
    </style>

</resources>
